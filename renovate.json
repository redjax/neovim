{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>redjax/PipelineTemplates//config/renovate/default#main",
        "helpers:pinGitHubActionDigests",
        "docker:pinDigests"
    ],
    "packageRules": [
        {
            "description": "Group Docker dependencies",
            "matchManagers": [
                "dockerfile",
                "docker-compose"
            ],
            "groupName": "docker dependencies"
        },
        {
            "description": "Require review for GitHub Actions",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github actions",
            "automerge": false
        },
        {
            "description": "Group mise dependencies",
            "matchManagers": [
                "mise"
            ],
            "groupName": "mise dependencies"
        },
        {
            "description": "Group Node.js dependencies",
            "matchManagers": [
                "npm"
            ],
            "groupName": "node.js dependencies"
        }
    ]
}